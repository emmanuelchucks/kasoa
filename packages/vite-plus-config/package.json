{
  "name": "@kasoa/vite-plus-config",
  "version": "0.3.0",
  "description": "Kasoa's Vite+ configurations",
  "keywords": [
    "config",
    "kasoa",
    "tooling",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/emmanuelchucks/kasoa/tree/main/packages/vite-plus-config",
  "bugs": {
    "url": "https://github.com/emmanuelchucks/kasoa/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Emmanuel Chucks",
    "email": "hi@emmanuelchucks.com",
    "url": "https://emmanuelchucks.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmanuelchucks/kasoa.git",
    "directory": "packages/vite-plus-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.mts",
      "import": "./dist/src/index.mjs"
    },
    "./cloudflare-workers": {
      "types": "./dist/src/cloudflare-workers/index.d.mts",
      "import": "./dist/src/cloudflare-workers/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test --passWithNoTests",
    "verify:package": "publint --pack pnpm --strict && attw --pack --profile esm-only && node scripts/verify-packed-exports.mts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8",
    "wrangler": "^4.119.0"
  },
  "peerDependencies": {
    "@cloudflare/vitest-pool-workers": ">=0.13.0 <1",
    "typescript": ">=7 <8",
    "vite-plus": ">=0.2.8 <1",
    "wrangler": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vitest-pool-workers": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
