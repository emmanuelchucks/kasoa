{
  "name": "kasoa",
  "private": true,
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "check": "vp fmt --check && vp run --filter=@kasoa/* check",
    "check:fix": "vp fmt --write && vp run --filter=@kasoa/* check:fix",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "verify": "pnpm run audit && pnpm run check && pnpm run test && pnpm exec vp run verify-packages",
    "prepare": "vp config --no-agent",
    "clean": "git clean -xdf",
    "update:deps": "pnpm dlx taze latest -wrli"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.1",
    "@kasoa/vite-plus-config": "workspace:*",
    "@types/node": "24.13.3",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plus": "^0.2.9"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.22.0"
}
